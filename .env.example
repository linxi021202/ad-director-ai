DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# compose.dev.yml development database placeholders
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

AI_MODE=mock
ENABLE_REAL_TEXT=false
ENABLE_REAL_IMAGE=false
ENABLE_REAL_VIDEO=false
# 仅本地开发可开启；生产环境即使设为 true 也不会使用平台 Key
ALLOW_PLATFORM_KEYS=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image
QWEN_IMAGE_EDIT_MODEL=qwen-image-2.0
QWEN_IMAGE_SIZE=1152*2048
QWEN_IMAGE_PROMPT_EXTEND=false
QWEN_IMAGE_WATERMARK=false

VIDEO_PROVIDER=happyhorse
# 自动旁白复用百炼 Key，不向浏览器暴露密钥
COSYVOICE_BASE_URL=https://dashscope.aliyuncs.com
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_VOICE=longanyang
HAPPYHORSE_API_KEY=
HAPPYHORSE_BASE_URL=https://dashscope.aliyuncs.com
HAPPYHORSE_MODEL=happyhorse-1.0-r2v
HAPPYHORSE_VIDEO_ASSET_PATH=/demo-videos/hero-shot.mp4

MAX_TEXT_CALLS_PER_RUN=3
MAX_IMAGES_PER_RUN=12
MAX_REAL_VIDEO_SHOTS_PER_RUN=1
MAX_VIDEO_SECONDS_PER_SHOT=7
MAX_CONCURRENT_RENDERS=1
MAX_RENDER_QUEUE_SIZE=6




# Windows 可留空，服务端会自动查找 Chrome 或 Edge
REMOTION_BROWSER_EXECUTABLE=

# Anonymous project text storage (server-only)
STORAGE_ROOT=./storage
ANONYMOUS_SESSION_OWNERSHIP_SALT=
